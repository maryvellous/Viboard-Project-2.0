{
  "app": {
    "name": "Diaspro Viboard",
    "version": "1.0.4",
    "publisher": "Diaspro",
    "publisherUrl": "https://studiodiaspro.com",
    "appId": "it.diaspro.viboard",
    "description": "Campaign manager desktop local-first",
